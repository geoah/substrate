# Two toolchains with two indent conventions live in this tree, and neither is
# wrong: Go is tabs because gofmt says so, the console is two spaces because
# prettier says so. This file is what stops an editor imposing a third opinion
# on a file before either formatter has seen it.
#
# It is not a check. `mise run fmt:check` and `mise run console:fmt:check` are
# the enforcement; this is the hint an editor reads while you type.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

# The dev loop and the kinds guard are tab-indented, and shellcheck reads them
# the same either way — but a mixed file is genuinely hard to read.
[*.sh]
indent_style = tab

[Makefile]
indent_style = tab

# Trailing whitespace is significant in Markdown (two spaces is a line break),
# so nothing here may strip it.
[*.md]
trim_trailing_whitespace = false

# Generated by the package manager; its own format, not ours.
[pnpm-lock.yaml]
insert_final_newline = false
trim_trailing_whitespace = false

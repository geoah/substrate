# Build output. NOT `/substrate` — that pattern also hides the substrate/
# package, which is the core of this repo. `/substrated` is what a bare
# `go build ./cmd/substrated` at the top level leaves behind.
/bin/
/substrated

# Go
*.test
*.out
go.work
go.work.sum

# Node
node_modules/
dist/

# The Apple apps: xcodegen's project and xcodebuild's derived data. Here, not
# in apps/, because `.yamlfmt` reads this file alone, and the derived
# data holds YAML of Xcode's.
/apps/xcode/Substrate.xcodeproj/
/apps/xcode/build/
# The apps' release (.mise/apps.sh): staged builds, the site, and a dry run's
# simulated release folder and site.
/build/
/apps/kit/.build/
# `mise run apps:gallery`: every shared screen drawn, one folder per system.
/build/gallery/
/apps/kit/.swiftpm/
/apps/workouts/WorkoutsKit/.build/
/apps/chat/ChatKit/.build/
/apps/chat/ChatKit/.swiftpm/
/apps/workouts/WorkoutsKit/.swiftpm/
/apps/tasks/TasksKit/.build/
/apps/tasks/TasksKit/.swiftpm/
# Every app's core, the template's and one apps:new makes included.
/apps/*/*Kit/.build/
/apps/*/*Kit/.swiftpm/
/apps/kit/Tools/BridgeGen/.build/
/apps/kit/Tools/BridgeGen/.swiftpm/
# The Android build: Gradle's caches and every module's output.
/apps/gradle/.gradle/
/apps/gradle/.kotlin/
/apps/gradle/build/
/apps/gradle/build-logic/.gradle/
/apps/gradle/build-logic/.kotlin/
/apps/gradle/build-logic/build/
/apps/gradle/local.properties
/apps/kit/android/*/build/
/apps/*/android/build/

# Editors / OS
.DS_Store
.idea/
.vscode/*

# The dev substrate: the pid and the log of `mise run dev:up`.
/.dev/
.mise.local.toml

# Agent worktrees. A coding agent given its own checkout puts it here, inside
# the repo, and each one carries a whole console tree. `.yamlfmt` reads this
# file as its exclusion list, so without this line `mise run fmt:check` and
# `mise run lint:yaml` walk into a nested `pnpm-lock.yaml` and fail on a file
# that is not in the change. Only the worktrees: `.claude/` also holds
# settings and agent definitions somebody may want tracked.
/.claude/worktrees/

# Linter caches. `*.out` above already covers the coverage profile
# `mise run test:coverage` writes.
.ruff_cache/
.lycheecache

# Local deployment configuration: these hold KEYS. `.envrc` is direnv's and
# feeds compose's variable substitution; `.env` is compose's own. Neither is
# ever committed.
.envrc
.env

# Python bytecode: host.py is imported by a test probe, never installed.
__pycache__/
# The tree's own Python environment, which .mise/python.sh makes from
# .mise/python/uv.lock on its first run.
/.mise/python/.venv/

# A chat bridge store run from the tree: linked sessions, never committed.
/cmd/chatbridge/data/

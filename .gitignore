# Build output. NOT `/substrate` — that pattern also hides the substrate/
# package, which is the core of this repo.
/bin/

# Go
*.test
*.out
go.work
go.work.sum

# Node
node_modules/
dist/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# The dev substrate: the pid and the log of `mise run dev:up`.
/.dev/
.mise.local.toml

# Linter caches. `*.out` above already covers the coverage profile
# `mise run test:coverage` writes.
.ruff_cache/
.lycheecache

# Local deployment configuration: these hold KEYS. `.envrc` is direnv's and
# feeds compose's variable substitution; `.env` is compose's own. Neither is
# ever committed.
.envrc
.env

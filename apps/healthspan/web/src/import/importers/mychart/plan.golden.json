  "left": [
    {
      "what": "MyChart's Mystery marker",
      "why": "no metric for it (1 value)"
    },
    {
      "what": "the lab's comments on 1 value",
      "why": "a lab result has no property for them; they stay in each report's attached JSON"
    },
    {
      "what": "1 value MyChart files under a second order",
      "why": "kept once, in the first"
    },
    {
      "what": "1 lab order filed at a visit",
      "why": "no value of the order is written, so neither is its report, and the visit's encounter does not name it"
    },
    {
      "what": "Patient Instructions of visit CSN-1",
      "why": "its file is not in the export"
    },
    {
      "what": "the logos, footers and signatures embedded in 1 letter (files/letters/)",
      "why": "each letter's HTML is kept as its file, and its words as its text"
    },
    {
      "what": "1 message the owner sent",
      "why": "the communication kind holds what a provider sent"
    },
    {
      "what": "4 images embedded in messages",
      "why": "banners, logos and QR codes: an image repeated across most messages, or shaped like a logo"
    },
    {
      "what": "1 emergency contact (lists/personal-relationships.json)",
      "why": "the patient kind has no field for one"
    },
    {
      "what": "lists/histories.json",
      "why": "no kind holds it"
    },
    {
      "what": "the health summary's height and weight",
      "why": "measurements, not clinical records"
    }
  ],

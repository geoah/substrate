{
  "name": "@substrate/react",
  "private": true,
  "version": "0.124.0",
  "description": "React for a Substrate web app: the signed-in shell, the record and write hooks, Settings' sections and the grouped screen pieces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoah/substrate.git",
    "directory": "apps/kit/web/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "vite build --config ../vite.lib.ts && tsc -p tsconfig.build.json && node ../dts.mjs && cp src/theme.css dist/theme.css",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@substrate/auth": "workspace:*",
    "@substrate/client": "workspace:*",
    "@substrate/local": "workspace:*",
    "lucide-react": "^1.49.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@substrate/testing": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme.css": "./dist/theme.css"
    },
    "types": "./dist/index.d.ts"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>

{
  "source": "What each first-party app asks a substrate for, as its manifest spells it: apps/sync/apple/Sources/App/Manifest.swift (ReachTests holds it to this file) and apps/workouts/core/Sources/WorkoutsSync/WorkoutsManifest.swift (CoachTests does). internal/catalog's first-party reach test reads it, with the real closures, in place of a hand copy.",
  "sync": {
    "scopes": [
      "write:providers.substrate.reamde.dev/apple/*",
      "write:providers.substrate.reamde.dev/applehealth/account",
      "write:providers.substrate.reamde.dev/applehealth/export",
      "write:providers.substrate.reamde.dev/applehealth/*",
      "write:substrate.reamde.dev/health/sleep",
      "write:substrate.reamde.dev/health/workout",
      "write:substrate.reamde.dev/observations/*"
    ],
    "packages": [
      "providers.substrate.reamde.dev/apple",
      "providers.substrate.reamde.dev/applehealth"
    ]
  },
  "workouts": {
    "scopes": [
      "write:substrate.reamde.dev/training/*",
      "read:providers.substrate.reamde.dev/applehealth/account",
      "read:substrate.reamde.dev/health/workout",
      "read:substrate.reamde.dev/health/sleep",
      "read:substrate.reamde.dev/observations/*",
      "read:substrate.reamde.dev/clinical/*",
      "agents:substrate.reamde.dev/trainingcoach/*"
    ],
    "packages": [
      "substrate.reamde.dev/health",
      "substrate.reamde.dev/training",
      "substrate.reamde.dev/trainingcoach"
    ]
  }
}

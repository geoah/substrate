<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's own App Group, where the app writes the widgets' day:
	     this extension reads it there and writes nothing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.reamde.substrate.today</string>
	</array>
</dict>
</plist>

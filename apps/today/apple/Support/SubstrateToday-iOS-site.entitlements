<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The site host the release publishes its association file on: the
	     system hands the sign-in's https callback there to this app alone
	     (ASWebAuthenticationSession's https callback), under both services. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(SUBSTRATE_SITE_HOST)</string>
		<string>applinks:$(SUBSTRATE_SITE_HOST)</string>
	</array>
	<!-- The Keychain group the app and its widget extension share: the
	     app's own identifier, so the session every build wrote is already
	     in it. The app writes the widgets' day there, and the extension
	     reads it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.reamde.substrate.today</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An app's records go to the substrate its owner signs in to and to
	     nobody else: the publisher collects nothing and tracks nobody. An
	     app that sends its publisher anything declares it in a manifest of
	     its own, and in App Privacy in App Store Connect, which must say
	     the same. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- The required-reason APIs the app and the kit linked into it call.
	     App Store Connect refuses an upload that calls one it does not
	     declare (ITMS-91053). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults and @AppStorage: the app's own settings, such as
		     the server last signed in to. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- File modification dates: when each saved copy in the app's own
		     folder was last used (SubstrateLocal's RepositoryFolder). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- The uptime clock: how long the app's own work took and when a
		     wait ends (SubstrateRuntime's Meter, the outbox's timers). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

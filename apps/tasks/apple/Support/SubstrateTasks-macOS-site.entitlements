<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Signing in, in a build that claims no https redirect: the browser
	     returns to a loopback port the app listens on (RFC 8252). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Sparkle's installer runs outside the sandbox, as launchd services
	     the sandboxed app may only reach by these two names. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- The site host the release publishes its association file on: the
	     system hands the sign-in's https callback there to this app alone
	     (ASWebAuthenticationSession's https callback), under both services. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(SUBSTRATE_SITE_HOST)</string>
		<string>applinks:$(SUBSTRATE_SITE_HOST)</string>
	</array>
</dict>
</plist>
